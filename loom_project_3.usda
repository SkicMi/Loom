def Scope "Materials"
{
    custom bool loom:materialLibrary = 1

    def Material "rigged_Material_0_0"
    {
        token outputs:surface.connect = </Materials/rigged_Material_0_0/Surface.outputs:surface>
        custom string loom:name = "rigged/Material_0"
        custom float4 loom:baseColor = (1, 1, 1, 1)
        custom float loom:metallic = 1
        custom float loom:roughness = 1
        custom color3f loom:emissive = (0, 0, 0)
        custom float loom:emissiveStrength = 1
        custom token loom:alphaMode = "opaque"
        custom float loom:alphaCutoff = 0.5
        custom bool loom:doubleSided = 1
        custom asset loom:baseColorMap = @/home/danijel/Desktop/Loom/tools/autorig/outputs/mascot-03/rigged.glb@
        custom int4 loom:baseColorMapInfo = (1, 0, 0, 0)
        custom float loom:baseColorMapAmount = 1
        custom asset loom:metallicRoughnessMap = @/home/danijel/Desktop/Loom/tools/autorig/outputs/mascot-03/rigged.glb@
        custom int4 loom:metallicRoughnessMapInfo = (2, 0, 0, 0)
        custom float loom:metallicRoughnessMapAmount = 1
        custom asset loom:normalMap = @/home/danijel/Desktop/Loom/tools/autorig/outputs/mascot-03/rigged.glb@
        custom int4 loom:normalMapInfo = (0, 0, 0, 0)
        custom float loom:normalMapAmount = 1

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            float inputs:metallic = 1
            float inputs:roughness = 1
            float inputs:opacity = 1
            color3f inputs:emissiveColor = (0, 0, 0)
            token outputs:surface
        }
    }
}
